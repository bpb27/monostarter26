# Local dev secrets (gitignored). Edit here, then run `pnpm env:sync`.

# Local Postgres from docker-compose (prod: Railway ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@localhost:5433/monostarter

# Clerk (https://dashboard.clerk.com -> API keys)
CLERK_SECRET_KEY=sk_test_...

CLERK_PUBLISHABLE_KEY=pk_test_...

# Server URL. Mobile on a physical device: use your machine's LAN IP, not localhost.
API_URL=http://localhost:8787

PORT=8787

NODE_ENV=development

# Comma-separated browser origins allowed by CORS (prod: your web app URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

