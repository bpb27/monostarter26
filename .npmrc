# Keep the store local to the workspace for reproducibility across machines.
# Expo (SDK 54+) supports pnpm's default isolated node-linker; leave it isolated.
# Some RN native modules occasionally need hoisting — uncomment if you hit
# "module not found" during a native build:
# node-linker=hoisted

# Allow build scripts only for packages we trust (pnpm 10+ blocks by default).
strict-peer-dependencies=false
auto-install-peers=true
