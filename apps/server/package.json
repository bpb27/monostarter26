{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/hono": "^0.1.47",
    "@hono/node-server": "^2.0.8",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "hono": "^4.12.28",
    "kysely": "^0.29.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^26.1.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.23.0",
    "vitest": "^4.1.10"
  }
}
