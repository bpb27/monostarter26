{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/web-user/Dockerfile",
    "watchPatterns": [
      "apps/web-user/**",
      "packages/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      ".npmrc"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
